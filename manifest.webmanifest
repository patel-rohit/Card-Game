{
  "id": "./",
  "name": "Points Game",
  "short_name": "Points Game",
  "description": "Score keeper for card nights: log points, rankings by total or average, history, player summaries and WhatsApp sharing. Works offline.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#063a25",
  "theme_color": "#063a25",
  "categories": ["games", "entertainment", "utilities"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "assets/img/logo-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/logo-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/logo-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/img/logo.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Log a game", "short_name": "Log game", "url": "./?tab=log&source=shortcut", "icons": [{ "src": "assets/img/logo-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Ranking", "short_name": "Ranking", "url": "./?tab=ranking&source=shortcut", "icons": [{ "src": "assets/img/logo-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "History", "short_name": "History", "url": "./?tab=history&source=shortcut", "icons": [{ "src": "assets/img/logo-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "screenshots": [
    { "src": "assets/img/screenshots/phone-log.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Tap players and enter points" },
    { "src": "assets/img/screenshots/phone-summary.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Player summary: what went well and what didn't" },
    { "src": "assets/img/screenshots/desktop-history.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Game history with the score after every game" }
  ]
}
